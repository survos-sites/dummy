{% extends 'layout.html.twig' %}

{% block title 'Dummy' %}

{% block body %}
    <div class="row row-cards">
        <div class="col-sm-6">
            <div class="card"><div class="card-body">
                <div class="subheader">Products</div>
                <div class="h1 mb-0">{{ productCount|number_format }}</div>
            </div></div>
        </div>
        <div class="col-sm-6">
            <div class="card"><div class="card-body">
                <div class="subheader">Images</div>
                <div class="h1 mb-0">{{ imageCount|number_format }}</div>
            </div></div>
        </div>
    </div>

    {% if productCount == 0 or imageCount == 0 %}
        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title">Getting started</h3></div>
            <div class="card-body">
                {% if productCount == 0 %}
                    <p>There are no products yet. Load them from <code>data/products.json</code> (DummyJSON); this also registers each product's images:</p>
                    <pre class="mb-3"><code>bin/console app:load</code></pre>
                    <p class="text-secondary">Use <code>--limit=20</code> for a small sample, or <code>--purge</code> to start over.</p>
                {% else %}
                    <p>Products are loaded, but no images have been created yet. Re-run the loader to register the product images:</p>
                    <pre class="mb-3"><code>bin/console app:load</code></pre>
                {% endif %}
                <p>Then check the image workflow and media status:</p>
                <pre class="mb-0"><code>bin/console media:stats</code></pre>
            </div>
        </div>
    {% else %}
        <div class="card mt-3">
            <div class="card-body">
                <twig:grid
                    :data="products"
                    :columns="[
                        {name: 'title', title: 'Title'},
                        {name: 'brand', title: 'Brand'},
                        {name: 'category', title: 'Category'},
                        {name: 'price', title: 'Price'},
                        {name: 'rating', title: 'Rating'},
                        {name: 'stock', title: 'Stock'},
                        {name: 'imageCount', title: 'Images'},
                    ]"
                    :pageLength="20"
                    :trans="false">
                    <twig:block name="title">
                        <a href="{{ path('app_product_show', {productId: row.sku}) }}">{{ row.title }}</a>
                    </twig:block>
                    <twig:block name="price">{{ row.price|number_format(2) }}</twig:block>
                </twig:grid>
            </div>
        </div>
        <div class="mt-3">
            <a class="btn btn-primary" href="{{ path('app_images') }}">Browse images</a>
        </div>
    {% endif %}
{% endblock %}
