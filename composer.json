{
    "type": "project",
    "name": "survos-sites/dummy",
    "description": "DummyJSON database with an image workflow",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-exif": "*",
        "ext-iconv": "*",
        "ext-imagick": "*",
        "api-platform/doctrine-orm": "^5.0",
        "api-platform/symfony": "^5.0",
        "bizkit/versioning-bundle": "^2.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.5",
        "easycorp/easyadmin-bundle": "^4.25|^5.0",
        "friendsofsymfony/jsrouting-bundle": "^3.5",
        "imagine/imagine": "^1.3",
        "inspector-apm/inspector-symfony": "^1.8",
        "jolicode/jolinotif": "^3.1.1",
        "league/flysystem": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.30",
        "league/flysystem-bundle": "^3.0",
        "liquid/liquid": "^1.4",
        "mezcalito/imgproxy-bundle": "*",
        "nadar/php-composer-reader": "^2.1",
        "nelmio/cors-bundle": "^2.5",
        "nyholm/psr7": "^1.0",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.1",
        "survos/babel-bundle": "^2.41",
        "survos/doc-bundle": "^2.0",
        "survos/ez-bundle": "^2.0",
        "survos/grid-bundle": "^2.36",
        "survos/jsonl-bundle": "^2.0",
        "survos/lingua-bundle": "^2.41",
        "survos/lingua-contracts": "^2.5",
        "survos/media-bundle": "^2.41",
        "survos/state-bundle": "^2.0",
        "survos/tabler-bundle": "^2.10",
        "symfony/asset": "^8.2",
        "symfony/asset-mapper": "^8.2",
        "symfony/console": "^8.2",
        "symfony/doctrine-messenger": "^8.2",
        "symfony/dotenv": "^8.2",
        "symfony/expression-language": "^8.2",
        "symfony/flex": "^2",
        "symfony/form": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/intl": "^8.2",
        "symfony/joli-notif-notifier": "^8.2",
        "symfony/mailer": "^8.2",
        "symfony/mime": "^8.2",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "^8.2",
        "symfony/object-mapper": "^8.2",
        "symfony/process": "^8.2",
        "symfony/property-access": "^8.2",
        "symfony/property-info": "^8.2",
        "symfony/runtime": "^8.2",
        "symfony/security-bundle": "^8.2",
        "symfony/serializer": "^8.2",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/string": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/ux-chartjs": "^3.0",
        "symfony/ux-icons": "^3.0",
        "symfony/ux-turbo": "^3.0",
        "symfony/ux-twig-component": "^3.0",
        "symfony/validator": "^8.2",
        "symfony/web-link": "^8.2",
        "symfony/yaml": "^8.2",
        "twig/extra-bundle": "^3.0",
        "twig/intl-extra": "^3.22",
        "twig/twig": "^3.0",
        "yethee/tiktoken": "^1.0",
        "zenstruck/messenger-monitor-bundle": "^0.6.0"
    },
    "config": {
        "allow-plugins": {
            "endroid/installer": false,
            "php-http/discovery": true,
            "survos/installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            
            "fos:js-routing:dump --format=json --target=public/js/fos_js_routes.json": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ],
        "coverage": "rm var/test.db -f && bin/console d:sc:update --force --env=test && php -d xpcov.enabled=1 vendor/bin/phpunit --coverage-html coverage",
        "diagram": "bin/console doctrine:diagram:er --filename=assets/db.svg --exclude=doctrine_migration_versions,messenger_messages"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^8.2"
        }
    },
    "require-dev": {
        "jawira/doctrine-diagram-bundle": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "roave/security-advisories": "dev-latest",
        "survos/code-bundle": "^2.41",
        "survos/command-bundle": "^2.0",
        "symfony/browser-kit": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/debug-bundle": "^8.2",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "^8.2",
        "symfony/stopwatch": "^8.2",
        "symfony/web-profiler-bundle": "^8.2"
    }
}
